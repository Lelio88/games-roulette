{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && ((data.exists() && data.child('host').val() === auth.uid) || (!data.exists() && newData.child('host').val() === auth.uid))",
        ".validate": "$roomId.matches(/^[A-HJ-NP-Z2-9]{5}$/) && newData.hasChildren(['host', 'createdAt', 'state'])",
        "host": {
          ".validate": "newData.isString() && newData.val().length <= 128 && (!data.exists() || newData.val() === data.val())"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
        },
        "state": {
          ".validate": "newData.hasChildren(['phase', 'round'])",
          "phase": { ".validate": "newData.isString() && newData.val().matches(/^(idle|spinning|guessing|resolved)$/)" },
          "round": { ".validate": "newData.isNumber()" },
          "finalRotation": { ".validate": "newData.isNumber()" },
          "soundUrl": { ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^assets\\/[a-z0-9_\\/-]{1,120}\\.ogg$/))" },
          "winnerId": { ".validate": "newData.isString() && newData.val().length <= 128" },
          "winnerName": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "entityName": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "$other": { ".validate": false }
        },
        "players": {
          "$playerId": {
            ".write": "auth != null && auth.uid === $playerId && (!newData.exists() || (data.parent().parent().child('host').exists() && newData.child('points').val() === 0))",
            ".validate": "newData.hasChildren(['name', 'points'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
            "points": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
            "joined": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "guesses": {
          "$guessId": {
            ".write": "auth != null && !data.exists() && newData.child('playerId').val() === auth.uid && !newData.child('verdict').exists() && data.parent().parent().child('players').child(auth.uid).exists() && data.parent().parent().child('state/phase').val() === 'guessing'",
            ".validate": "newData.hasChildren(['playerId', 'text'])",
            "playerId": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
            "timestamp": { ".validate": "newData.isNumber()" },
            "verdict": { ".validate": "newData.isString() && newData.val().matches(/^(correct|wrong)$/)" },
            "$other": { ".validate": false }
          }
        },
        "won": {
          "$entity": { ".validate": "newData.isBoolean() && $entity.length <= 40" }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
